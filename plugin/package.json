{
  "name": "zotero-paper-highlighter",
  "type": "module",
  "version": "0.1.0",
  "description": "Automatically highlights the key sentences of a paper (Contribution / Method / Result) when its PDF is opened.",
  "config": {
    "addonName": "Paper Highlighter",
    "addonID": "paper-highlighter@csci1377.example",
    "addonRef": "paperhighlighter",
    "addonInstance": "PaperHighlighter",
    "prefsPrefix": "extensions.zotero.paperhighlighter"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ody000/zotero_plugin.git"
  },
  "author": "Ziqi Shen, Jean Yoo",
  "bugs": {
    "url": "https://github.com/ody000/zotero_plugin/issues"
  },
  "homepage": "https://github.com/ody000/zotero_plugin#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^6.0.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@zotero-plugin/eslint-config": "^0.6.10",
    "chai": "^6.3.0",
    "eslint": "^10.14.0",
    "mocha": "^12.0.3",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "zotero-plugin-scaffold": "^0.9.3",
    "zotero-types": "^4.1.3"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  },
  "overrides": {
    "typescript-eslint": {
      "typescript": "6.0.3"
    }
  }
}
